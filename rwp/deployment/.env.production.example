# deployment/.env.production
# Copy to .env.production (same folder), fill in, never commit. Plain KEY=value lines only.

# --- Docker Hub ---
DOCKERHUB_USER=your-dockerhub-username
# Tag printed by builds/publish_images.sh. Prefer an explicit tag over "latest".
IMAGE_TAG=latest
# Only if the Docker Hub repositories are private (the server then runs `docker login`):
# DOCKERHUB_TOKEN=

# --- Secrets (generate each with the command shown) ---
# openssl rand -hex 32     (JWT_SECRET must be at least 32 characters)
JWT_SECRET=
# openssl rand -hex 24
REDIS_PASSWORD=
# openssl rand -hex 16     (12-128 characters from A-Za-z0-9_.~-)
DB_PASSWORD=
DB_USERNAME=todo_admin

# --- Optional overrides ---
# AWS_REGION=ap-southeast-1
# SSH_CIDR=203.0.113.7/32
# SSH_KEY_PATH=$HOME/.ssh/keys/rwp_remotebuild.pem
# TF_BIN=terraform
