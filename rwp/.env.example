JWT_SECRET="replace with 'openssl rand -hex 32'"
POSTGRES_PASSWORD="replace with 'openssl rand -hex 32'"
REDIS_PASSWORD="replace with 'openssl rand -hex 32'"

TO_DO_WEB_HOST=127.0.0.1
TO_DO_WEB_PORT=8080
TO_DO_DB_URL=postgres://username:${POSTGRES_PASSWORD}@127.0.0.1:5432/to_do
TO_DO_MAX_CONNECTIONS=5

AUTH_WEB_HOST=127.0.0.1
AUTH_WEB_PORT=8081
AUTH_DB_URL=postgres://username:${POSTGRES_PASSWORD}@127.0.0.1:5432/auth
AUTH_API_URL=http://127.0.0.1:8081
AUTH_MAX_CONNECTIONS=5

INGRESS_WEB_HOST=0.0.0.0
INGRESS_WEB_PORT=8001
INGRESS_URL=http://127.0.0.1:8001
FRONTEND_DEV_ORIGIN=http://localhost:3000
COMPUTE_PLATFORM=linux/amd64
TRUST_PROXY=0

# Docker network endpoints used by the Compose deployment fragments.
TODO_DOCKER_DB_URL=postgres://username:${POSTGRES_PASSWORD}@postgres:5432/to_do
AUTH_DOCKER_DB_URL=postgres://username:${POSTGRES_PASSWORD}@postgres:5432/auth
TODO_DOCKER_API_URL=http://to_do:8080
AUTH_DOCKER_API_URL=http://auth:8081
INGRESS_DOCKER_API_URL=http://ingress:8001
CACHE_DOCKER_URL=redis://:${REDIS_PASSWORD}@cache:6379
CACHE_API_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379

